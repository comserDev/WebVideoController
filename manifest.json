{
  "manifest_version": 3,
  "name": "범용 비디오 배속 컨트롤러",
  "version": "1.2",
  "description": "모든 웹사이트의 비디오 재생 속도를 간편하게 조절하고 컨트롤할 수 있는 확장프로그램입니다.",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
	  "all_frames": true
	}
  ],
  "icons": {
	"16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aagag-video-controller@yourdomain.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}