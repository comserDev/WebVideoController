{
  "manifest_version": 3,
  "name": "웹(AAGAG) 비디오 컨트롤러",
  "version": "1.3.0",
  "description": "모든 웹사이트의 HTML5 비디오 바로 아래에 영상 너비와 같은 재생·배속 컨트롤 바를 표시합니다. 확장 아이콘에서 진단 정보를 확인할 수 있습니다.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "css": [
        "content.css"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "web-video-controller@ogoo59.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "Web Video Controller 1.3.0 진단",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
